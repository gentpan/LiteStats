# PostgreSQL
DATABASE_URL=postgres://litestats:litestats@127.0.0.1:5435/litestats?sslmode=disable

# ClickHouse，路径是数据库名
CLICKHOUSE_URL=http://127.0.0.1:8123/default

# 会话签名，生产环境必须换成随机长字符串
SESSION_KEY=
# 使用随机至少 32 位密钥；生产环境未配置会拒绝启动。
# 仅开发演示可开启；不会重置已有密码或加入已有团队。
SEED_DEMO=false
# 已验证邮箱的实例管理员，逗号分隔。
ADMIN_EMAILS=

# 可选：Google Search Console
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3100/api/auth/google
