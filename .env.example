# PostgreSQL
DATABASE_URL=postgres://litestats:litestats@127.0.0.1:5432/litestats?sslmode=disable

# ClickHouse，路径是数据库名
CLICKHOUSE_URL=http://127.0.0.1:8123/default

# 会话签名，生产环境必须换成随机长字符串
SESSION_KEY=change-me-in-production

# 可选：Google Search Console
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3100/api/auth/google
